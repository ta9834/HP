.vscode/
.idea/
*.swp
*.swo
*~

# ログファイル
*.log
npm-debug.log*

# 一時ファイル・バックアップ
*.bak
*.tmp
*.backup
*~$*

# 機密情報（万一の保護）
*.env
*.env.local
secrets.json
credentials.json
